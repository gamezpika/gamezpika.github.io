# Railway 注入 $PORT；本地測試 fallback 到 80
:{$PORT:80} {
    root * /srv
    file_server
    encode gzip zstd

    # 預設靜態資源 cache 短期（10 分鐘），方便派派改檔 cache-bust ?v=N 強刷
    header Cache-Control "public, max-age=600"

    # 題目圖（立體圖/塗色等「圖目」）放在後端當圖床。demo 站開了 COEP（cross-origin
    # isolation，給 Godot 網頁版用），跨來源圖片因圖床沒回 CORP 標頭會被瀏覽器擋掉
    # → 反向代理成「本站同源」，COEP 就放行。範圍只限題目圖 /static/images/q/*。
    #
    # 圖分散在兩個後端：截圖法新題（數學二是非/選擇）的圖在 demo 自己的後端
    # eduarena-tutoring；舊康軒 G4/G5 圖在正式版 48b09。所以先打 demo 後端，
    # 該後端沒這張時 failover 到 48b09 → 兩組圖都服務得到。
    # 後端「沒這張」會回 404（檔不在）或 307（轉址去 48b09 圖床）；兩種都要 failover，
    # 否則 307 直接丟回瀏覽器→跨來源 48b09 沒回 CORP→COEP 擋掉→圖消失。
    @qimg path /static/images/q/*
    reverse_proxy @qimg https://eduarena-tutoring-production.up.railway.app {
        header_up Host eduarena-tutoring-production.up.railway.app
        @imgmiss status 404 307
        handle_response @imgmiss {
            reverse_proxy https://web-production-48b09.up.railway.app {
                header_up Host web-production-48b09.up.railway.app
            }
        }
    }

    # Web build 需要 SharedArrayBuffer → 必須回 cross-origin isolation headers
    @godot {
        path /village-web/*
    }
    header @godot {
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
        Cross-Origin-Resource-Policy "same-origin"
    }

    # wasm / pck demo 階段頻繁迭代，no-cache 強制每次重新拉
    @big {
        path *.wasm *.pck
    }
    header @big >Cache-Control "no-cache, no-store, must-revalidate"

    # HTML entry pages（含內嵌 JS）每次重整都拿新版，避免黏舊 logic
    # JSON 配置（編輯器存的） 也要 no-cache，否則編輯器拿舊 frame size
    @htmlAndJson {
        path *.html *.json
    }
    header @htmlAndJson >Cache-Control "no-cache, must-revalidate"

    # 不公開原始檔
    @hidden {
        path /.git/* /Dockerfile /Caddyfile /.dockerignore /village-godot/*
    }
    respond @hidden 404
}
