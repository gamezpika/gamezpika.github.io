{
  "note": "詩詞接龍題庫：國小常背唐詩（五言），lines 兩兩成對出題（上半句→下半句）。派派 6/12 核准 30+1 首、不分年級混出。",
  "poems": [
    { "t": "靜夜思", "a": "李白", "l": ["床前明月光", "疑是地上霜", "舉頭望明月", "低頭思故鄉"] },
    { "t": "春曉", "a": "孟浩然", "l": ["春眠不覺曉", "處處聞啼鳥", "夜來風雨聲", "花落知多少"] },
    { "t": "登鸛雀樓", "a": "王之渙", "l": ["白日依山盡", "黃河入海流", "欲窮千里目", "更上一層樓"] },
    { "t": "憫農其二", "a": "李紳", "l": ["鋤禾日當午", "汗滴禾下土", "誰知盤中飧", "粒粒皆辛苦"] },
    { "t": "憫農其一", "a": "李紳", "l": ["春種一粒粟", "秋收萬顆子", "四海無閒田", "農夫猶餓死"] },
    { "t": "詠鵝", "a": "駱賓王", "l": ["白毛浮綠水", "紅掌撥清波"] },
    { "t": "風", "a": "李嶠", "l": ["解落三秋葉", "能開二月花", "過江千尺浪", "入竹萬竿斜"] },
    { "t": "畫", "a": "傳王維", "l": ["遠看山有色", "近聽水無聲", "春去花還在", "人來鳥不驚"] },
    { "t": "池上", "a": "白居易", "l": ["小娃撐小艇", "偷採白蓮回", "不解藏蹤跡", "浮萍一道開"] },
    { "t": "相思", "a": "王維", "l": ["紅豆生南國", "春來發幾枝", "願君多採擷", "此物最相思"] },
    { "t": "鹿柴", "a": "王維", "l": ["空山不見人", "但聞人語響", "返景入深林", "復照青苔上"] },
    { "t": "雜詩", "a": "王維", "l": ["君自故鄉來", "應知故鄉事", "來日綺窗前", "寒梅著花未"] },
    { "t": "送別", "a": "王維", "l": ["山中相送罷", "日暮掩柴扉", "春草明年綠", "王孫歸不歸"] },
    { "t": "江雪", "a": "柳宗元", "l": ["千山鳥飛絕", "萬徑人蹤滅", "孤舟蓑笠翁", "獨釣寒江雪"] },
    { "t": "遊子吟", "a": "孟郊", "l": ["慈母手中線", "遊子身上衣", "臨行密密縫", "意恐遲遲歸", "誰言寸草心", "報得三春暉"] },
    { "t": "尋隱者不遇", "a": "賈島", "l": ["松下問童子", "言師採藥去", "只在此山中", "雲深不知處"] },
    { "t": "草", "a": "白居易", "l": ["離離原上草", "一歲一枯榮", "野火燒不盡", "春風吹又生"] },
    { "t": "獨坐敬亭山", "a": "李白", "l": ["眾鳥高飛盡", "孤雲獨去閒", "相看兩不厭", "只有敬亭山"] },
    { "t": "夜宿山寺", "a": "李白", "l": ["危樓高百尺", "手可摘星辰", "不敢高聲語", "恐驚天上人"] },
    { "t": "古朗月行", "a": "李白", "l": ["小時不識月", "呼作白玉盤", "又疑瑤臺鏡", "飛在青雲端"] },
    { "t": "絕句", "a": "杜甫", "l": ["遲日江山麗", "春風花草香", "泥融飛燕子", "沙暖睡鴛鴦"] },
    { "t": "鳥鳴澗", "a": "王維", "l": ["人閒桂花落", "夜靜春山空", "月出驚山鳥", "時鳴春澗中"] },
    { "t": "宿建德江", "a": "孟浩然", "l": ["移舟泊煙渚", "日暮客愁新", "野曠天低樹", "江清月近人"] },
    { "t": "竹里館", "a": "王維", "l": ["獨坐幽篁裡", "彈琴復長嘯", "深林人不知", "明月來相照"] },
    { "t": "登樂遊原", "a": "李商隱", "l": ["向晚意不適", "驅車登古原", "夕陽無限好", "只是近黃昏"] },
    { "t": "塞下曲·月黑", "a": "盧綸", "l": ["月黑雁飛高", "單于夜遁逃", "欲將輕騎逐", "大雪滿弓刀"] },
    { "t": "塞下曲·林暗", "a": "盧綸", "l": ["林暗草驚風", "將軍夜引弓", "平明尋白羽", "沒在石稜中"] },
    { "t": "秋浦歌", "a": "李白", "l": ["白髮三千丈", "緣愁似箇長", "不知明鏡裡", "何處得秋霜"] },
    { "t": "渡漢江", "a": "宋之問", "l": ["嶺外音書斷", "經冬復歷春", "近鄉情更怯", "不敢問來人"] },
    { "t": "逢雪宿芙蓉山主人", "a": "劉長卿", "l": ["日暮蒼山遠", "天寒白屋貧", "柴門聞犬吠", "風雪夜歸人"] },
    { "t": "春夜喜雨", "a": "杜甫", "l": ["好雨知時節", "當春乃發生", "隨風潛入夜", "潤物細無聲"] }
  ]
}
